# Copy to ~/.omp/agent/models.yml
#
# The llama.cpp server behind this repo, as a custom omp provider.
# apiKey: none satisfies omp's key requirement for a keyless endpoint.
# Keep contextWindow in sync with the server's -c value.
providers:
  bonsai-local:
    baseUrl: http://127.0.0.1:8080/v1
    api: openai-completions
    apiKey: none
    models:
      - id: bonsai-27b
        name: Ternary Bonsai 27B (local)
        reasoning: true
        input: [text]
        contextWindow: 262144
        maxTokens: 16384
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }

ARG UBUNTU_VERSION=24.04
ARG CUDA_VERSION=13.3.1

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS build

# Self-build variant: everything tuned to THIS machine instead of a portable
# multi-arch image.
#
#   GGML_NATIVE=ON          -> CPU backend compiled with -march=native
#   CUDA_DOCKER_ARCH=native -> only your GPU's compute capability is compiled
#
# Building one architecture instead of the full set is the whole point: the
# fork has ~600 CUDA translation units (384 of them TurboQuant flash-attention
# instances), so a multi-arch build takes hours where a single-arch build takes
# well under one.
#
# Use ./build-native.sh — it reads the compute capability off the host and
# passes it in. A plain `docker build` cannot resolve "native" itself: unless
# the Docker daemon's DEFAULT runtime is nvidia, the build container has no GPU
# and CMake's native detection finds nothing. The guard below fails loudly in
# that case instead of silently producing a CPU-only or wrong-arch build.
ARG LLAMACPP_REPO=https://github.com/spiritbuun/buun-llama-cpp
ARG LLAMACPP_REF=7b9bf9d5052921d299a8fca947897514caea6261
ARG CUDA_DOCKER_ARCH=native
ARG GGML_NATIVE=ON

RUN apt-get update && \
    apt-get install -y gcc-14 g++-14 build-essential cmake python3 git libssl-dev libgomp1

ENV CC=gcc-14 CXX=g++-14 CUDAHOSTCXX=g++-14

WORKDIR /app
RUN git init -q . && \
    git remote add origin ${LLAMACPP_REPO} && \
    git fetch --depth 1 origin ${LLAMACPP_REF} && \
    git checkout -q FETCH_HEAD

RUN if [ "${CUDA_DOCKER_ARCH}" = "native" ] && ! command -v nvidia-smi >/dev/null 2>&1; then \
        echo "ERROR: CUDA_DOCKER_ARCH=native, but no GPU is visible inside the build container."; \
        echo "       Use ./build-native.sh (it detects the compute capability on the host),"; \
        echo "       or pass it yourself, e.g. --build-arg CUDA_DOCKER_ARCH=89."; \
        exit 1; \
    fi && \
    cmake -B build \
        -DGGML_NATIVE=${GGML_NATIVE} \
        -DGGML_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_DOCKER_ARCH} \
        -DGGML_CUDA_FA=ON \
        -DGGML_CUDA_FA_ALL_QUANTS=ON \
        -DLLAMA_BUILD_TESTS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined . && \
    cmake --build build --config Release -j$(nproc)

RUN mkdir -p /app/lib && \
    find build -name "*.so*" -exec cp -P {} /app/lib \;

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS server

RUN apt-get update && \
    apt-get install -y libgomp1 curl && \
    apt clean -y && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /app/lib/ /app
COPY --from=build /app/build/bin/llama-server /app

ENV LLAMA_ARG_HOST=0.0.0.0
WORKDIR /app
HEALTHCHECK CMD [ "curl", "-f", "http://localhost:8080/health" ]
ENTRYPOINT [ "/app/llama-server" ]
